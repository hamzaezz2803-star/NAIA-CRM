# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback for older Supabase projects. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only app access policy.
# Leave AUTH_ALLOWED_EMAILS blank to allow the full Qarizmi email domain.
# Set it to a comma-separated allowlist to restrict production to exact users.
AUTH_ALLOWED_EMAIL_DOMAIN=qarizmi.com
AUTH_ALLOWED_EMAILS=

# Server-side AI provider credentials. Keep blank locally to use browser/local fallbacks.
NAIA_ACTION_APPROVAL_SECRET=
GROQ_API_KEY=
# Legacy Groq alias supported by NAIA routes. Prefer GROQ_API_KEY.
GROQ_KEY=
# Workload-specific text model routing. Qwen handles semantic orchestration;
# GPT-OSS provides strict-schema fallback; the smaller model is limited to
# bounded, low-risk copy such as follow-up drafts.
GROQ_ORCHESTRATOR_MODEL=qwen/qwen3.6-27b
GROQ_STRUCTURED_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_RESEARCH_MODEL=groq/compound-mini
# Legacy single-model override. Retiring model IDs are ignored fail-safe.
GROQ_MODEL=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Use "auto" for bilingual French/English voice notes. Set an ISO language
# code only when every recording is expected to use that language.
GROQ_WHISPER_LANGUAGE=auto
ELEVENLABS_API_KEY=
# Required official NAIA voice. There is no voice ID built into the app.
ELEVENLABS_VOICE_ID=
# Optional distinct rescue voice, used only when the official voice is rejected
# or unavailable. Browser speech synthesis remains the final client fallback.
ELEVENLABS_FALLBACK_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Cofounders-only shared drive (client IP). All Drive writes go through the
# org service account, which must be a member of that shared drive.
# GOOGLE_SERVICE_ACCOUNT_KEY: full JSON key of the service account (single
# line as downloaded from Google Cloud, or base64-encoded). Server-only.
GOOGLE_SERVICE_ACCOUNT_KEY=
# "clients" folder: per-client CRM folders and Maya pitch outputs.
MAYA_DRIVE_OUTPUT_FOLDER_ID=
# Pitch library folder: templates and reference decks Maya reads.
MAYA_DRIVE_SOURCE_FOLDER_ID=

# Maya Docs Generator. Server-only; access is restricted to Ali/Nabil in code.
MAYA_DRIVE_SOURCE_FOLDER_ID=1IeekoGpVpIwGRHsYjS1cuvPnSP9OJsmH
MAYA_DRIVE_OUTPUT_FOLDER_ID=1ayZ6wUIpWElEM4N0Xm1UqHRNzCz0uSn0
MAYA_ALLOWED_EMAILS=ali@qarizmi.com,nabil@qarizmi.com
MAYA_OPENAI_API_KEY=
MAYA_OPENAI_MODEL=gpt-5.5
MAYA_OPENAI_REASONING_EFFORT=medium

# Local Qarizmi Meeting Notes companion. Generate one high-entropy secret and
# set the exact same value in Vercel and on the founders' Mac. The companion
# only makes outbound HTTPS calls; no Mac port is exposed to the internet.
MEETING_NOTES_COMPANION_TOKEN=

# Local/dev seed for CRM when Supabase auth or data is not available.
# Use enabled in Vercel only for a sandbox demo environment.
CRM_DUMMY_DATA=enabled

# Future provider credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NAIA Slack bridge (DM/mention the bot, approve actions with buttons).
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...) with chat:write,
# im:history, app_mentions:read, users:read, users:read.email scopes.
# SLACK_SIGNING_SECRET: "Signing Secret" from the Slack app Basic Information
# page; verifies X-Slack-Signature on /api/slack/events and
# /api/slack/interactions. Both are server-only.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Private NAIA Slack briefing. Vercel Cron sends one authenticated request at
# each possible Morocco UTC offset; the route dispatches only at 09:30 local
# and the database prevents duplicates. Keep CRON_SECRET server-only.
CRON_SECRET=
NAIA_DAILY_BRIEF_RECIPIENTS=ali@qarizmi.com
NAIA_DAILY_BRIEF_TIME_ZONE=Africa/Casablanca

# Private NAIA WhatsApp bridge (Meta WhatsApp Business Cloud API). Server-only.
# WHATSAPP_ACCESS_TOKEN: permanent System User token with the
# whatsapp_business_messaging permission (Meta Business Settings).
# WHATSAPP_PHONE_NUMBER_ID: the "Phone number ID" of the sending number from
# the app WhatsApp > API Setup page (an ID, not the visible phone number). The
# inbound webhook also requires this exact destination id before processing.
# WHATSAPP_VERIFY_TOKEN: random string of your choice; must match the
# "Verify token" typed in the Meta webhook configuration (GET handshake).
# WHATSAPP_APP_SECRET: Meta app secret (App settings > Basic); verifies the
# X-Hub-Signature-256 HMAC on POST /api/whatsapp/webhook.
# WHATSAPP_USER_MAP is the private authorization boundary: phone→email pairs
# separated by commas, with numbers in international format without + or
# spaces. Only mapped numbers are scheduled for processing. Every other sender
# is silently ignored with no reply, storage, CRM/provider read, or LLM call.
# Example: 212661234567:ali@qarizmi.com,33612345678:nabil@qarizmi.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_USER_MAP=
WHATSAPP_BUSINESS_ACCOUNT_ID=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
