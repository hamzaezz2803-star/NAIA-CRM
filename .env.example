# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback for older Supabase projects. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only app access policy.
# Leave AUTH_ALLOWED_EMAILS blank to allow the full Qarizmi email domain.
# Set it to a comma-separated allowlist to restrict production to exact users.
AUTH_ALLOWED_EMAIL_DOMAIN=qarizmi.com
AUTH_ALLOWED_EMAILS=

# Future provider credentials. Keep blank until the integrations are implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
